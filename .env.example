# ORBIT runtime configuration — copy to .env and fill in values.
# Never commit real secrets. All keys are optional for local TinyLM / echo.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
ORBIT_HOST=127.0.0.1
ORBIT_PORT=8000
ORBIT_DATA_DIR=.orbit_data

# ---------------------------------------------------------------------------
# Model provider selection
#   auto       — ollama if healthy, else tinylm, else echo
#   tinylm     — local educational TinyLM
#   ollama     — local Ollama HTTP API
#   openai     — OpenAI-compatible /v1 (remote or local)
#   resilient  — multi-provider failover + key rotation + response cache
#   echo       — deterministic test stub
# ---------------------------------------------------------------------------
ORBIT_MODEL_PROVIDER=auto
ORBIT_MODEL_NAME=
ORBIT_MAX_TOKENS=256
ORBIT_TEMPERATURE=0.7
ORBIT_MAX_STEPS=20
ORBIT_MAX_TOOL_CALLS=30

# ---------------------------------------------------------------------------
# OpenAI-compatible backend (used when provider=openai or resilient)
# ---------------------------------------------------------------------------
ORBIT_OPENAI_BASE_URL=https://api.openai.com/v1
ORBIT_OPENAI_API_KEY=
# OPENAI_API_KEY is also accepted as a fallback alias

# ---------------------------------------------------------------------------
# Failover chain (provider=resilient)
# ---------------------------------------------------------------------------
ORBIT_FAILOVER_PROVIDERS=openai,ollama,tinylm,echo
ORBIT_CACHE_ENABLED=1
ORBIT_CACHE_TTL_S=300
ORBIT_CACHE_MAX=256

# ---------------------------------------------------------------------------
# Ollama
# ---------------------------------------------------------------------------
ORBIT_OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---------------------------------------------------------------------------
# TinyLM lab
# ---------------------------------------------------------------------------
ORBIT_TINYLM_PRESET=rope
# Use 1m for ~1.15M-param educational TinyLM: ORBIT_TINYLM_PRESET=1m
# Multi-step Thinker for questions:
# ORBIT_THINK=1
# ORBIT_THINK=0 disables Thinker (handle-only path)
ORBIT_TINYLM_CKPT=

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
ORBIT_RAG_ENABLED=1
ORBIT_MEMORY_ENABLED=1
ORBIT_WEB_ENABLED=1

# ---------------------------------------------------------------------------
# Optional: API auth
# ---------------------------------------------------------------------------
# ORBIT_API_KEY=
